# Generate: uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
MASTER_KEY=replace-with-generated-fernet-key
PUBLIC_URL=http://localhost:5173
# Defaults to PUBLIC_URL in Compose; only override for a separate console origin.
# CONSOLE_ORIGIN=http://localhost:5173
GATEWAY_PORT=5173
# Local HTTP only. Set true behind HTTPS in production.
COOKIE_SECURE=false
WORKERS=1
# Leave unset for the bundled Compose services; set both for external services.
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/gateway
# REDIS_URL=redis://host:6379/0
